---
import BaseLayout from "./BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
interface Props { english: boolean; title: string; description: string; slug: string }
const {english,title,description,slug}=Astro.props;
---
<BaseLayout lang={english?"en":"es"} title={title+" | Alessandro Campos"} description={description}>
  <Header />
  <main class="folio">
    <div class="folio-mast">
      <a href={english?"/en/":"/"}>{english?"Development journal":"Bitácora de desarrollo"}</a>
      <nav aria-label={english?"Language":"Idioma"}><strong>{english?"EN":"ES"}</strong> / <a href={(english?"/":"/en/")+slug+"/"} hreflang={english?"es":"en"}>{english?"ES":"EN"}</a></nav>
    </div>
    <header class="folio-heading"><h1>{title}</h1><p>{description}</p></header>
    <slot />
  </main>
  <Footer />
</BaseLayout>
<style>
.folio{max-width:64rem;margin:auto;padding:1.5rem clamp(1rem,4%,3rem) 2rem}
.folio-mast{display:flex;justify-content:space-between;align-items:center;gap:1rem;font:0.85rem/1.6 ui-monospace,monospace;border-bottom:1px solid var(--border);padding:1rem 0}
.folio-mast a{color:var(--accent)}.folio-mast a:hover{text-decoration:underline}
.folio-heading{padding:2.5rem 0 1.75rem;border-bottom:1px solid var(--border)}
h1{font:700 3rem/1.08 system-ui}p{color:var(--muted);line-height:1.7;max-width:42rem;margin-top:.85rem}
@media(max-width:650px){h1{font-size:2.4rem}.folio-heading{padding:1.5rem 0}.folio{padding-top:.5rem}}
</style>
