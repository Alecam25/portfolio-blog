---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const projects = await getCollection("projects");

  return projects.map((project, i) => ({
    params: { slug: project.data.slug },
    props: {
      project,
      prev: projects[i - 1] ?? null,
      next: projects[i + 1] ?? null,
    },
  }));
}

const { project, prev, next } = Astro.props;
const { Content } = await render(project);
const techList = project.data.tech.split(",").map((t: string) => t.trim());
---

<BaseLayout
  title={`${project.data.title} | Alessandro Campos`}
  description={project.data.description}
>
  <div class="min-h-screen flex flex-col">
    <Header />

    <main class="flex-1">
      <section class="hero-shell border-b border-white/10">
        <div class="container-custom py-14 md:py-18">
          <a href="/projects" class="mb-8 inline-flex items-center gap-2 text-sm text-slate-400 transition hover:text-cyan-300">
            <span aria-hidden="true">&lt;-</span>
            Back to Projects
          </a>

          <div class="grid gap-10 lg:grid-cols-[1fr_0.42fr] lg:items-start">
            <div>
              <p class="mb-5 text-sm uppercase tracking-[0.28em] text-cyan-300">Project case study</p>
              <h1 class="max-w-4xl text-4xl font-bold leading-tight md:text-5xl">
                {project.data.title}
              </h1>
              <p class="mt-6 max-w-3xl text-lg leading-9 text-slate-300">
                {project.data.description}
              </p>

              <div class="mt-8 flex flex-wrap gap-2">
                {techList.map((item: string) => (
                  <span class="rounded-full border border-cyan-300/25 bg-cyan-300/10 px-3 py-1 text-xs font-medium text-cyan-200">
                    {item}
                  </span>
                ))}
              </div>
            </div>

            <aside class="rounded-xl border border-white/10 bg-slate-950/80 p-6 shadow-2xl shadow-black/30">
              <p class="mb-4 text-sm font-semibold text-white">Project actions</p>
              <div class="flex flex-col gap-3">
                {project.data.demo && (
                  <a
                    href={project.data.demo}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="rounded-lg bg-cyan-300 px-5 py-3 text-center font-semibold text-slate-950 transition hover:bg-cyan-200"
                  >
                    Open Live Demo
                  </a>
                )}

                {project.data.github && (
                  <a
                    href={project.data.github}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="rounded-lg border border-white/20 px-5 py-3 text-center font-semibold text-white transition hover:border-cyan-300 hover:text-cyan-300"
                  >
                    View Source Code
                  </a>
                )}

                <a
                  href="/contact"
                  class="rounded-lg border border-white/20 px-5 py-3 text-center font-semibold text-slate-300 transition hover:border-cyan-300 hover:text-cyan-300"
                >
                  Ask About This Project
                </a>
              </div>

              <div class="mt-6 border-t border-white/10 pt-5">
                <p class="mb-3 text-xs uppercase tracking-[0.22em] text-slate-500">Stack summary</p>
                <div class="flex flex-wrap gap-2">
                  {techList.slice(0, 5).map((item: string) => (
                    <span class="rounded-md bg-white/5 px-2.5 py-1 text-xs text-slate-300">{item}</span>
                  ))}
                </div>
              </div>
            </aside>
          </div>
        </div>
      </section>

      <section class="container-custom py-14 md:py-20">
        <div class="grid gap-10 lg:grid-cols-[0.28fr_0.72fr]">
          <aside class="hidden lg:block">
            <div class="sticky top-28 rounded-xl border border-white/10 bg-slate-950/70 p-5">
              <p class="mb-4 text-xs uppercase tracking-[0.22em] text-slate-500">Case study</p>
              <nav class="space-y-3 text-sm text-slate-400">
                <a class="block transition hover:text-cyan-300" href="#overview">Overview</a>
                <a class="block transition hover:text-cyan-300" href="#details">Technical details</a>
                <a class="block transition hover:text-cyan-300" href="#navigation">More projects</a>
              </nav>
            </div>
          </aside>

          <article id="overview" class="project-content rounded-xl border border-white/10 bg-slate-950/60 p-6 md:p-8">
            <Content />
          </article>
        </div>
      </section>

      {(prev || next) && (
        <section id="navigation" class="section-band border-t border-white/10 py-12">
          <div class="container-custom">
            <p class="mb-6 text-xs uppercase tracking-[0.28em] text-slate-500">More Projects</p>
            <div class="grid gap-4 sm:grid-cols-2">
              {prev ? (
                <a href={`/projects/${prev.data.slug}`} class="group rounded-xl border border-white/10 bg-slate-950/70 p-6 transition hover:border-cyan-300/40 hover:bg-slate-900/80">
                  <p class="mb-2 text-xs text-slate-500">Previous</p>
                  <p class="font-semibold text-white transition group-hover:text-cyan-200">{prev.data.title}</p>
                </a>
              ) : <div />}

              {next ? (
                <a href={`/projects/${next.data.slug}`} class="group rounded-xl border border-white/10 bg-slate-950/70 p-6 text-right transition hover:border-cyan-300/40 hover:bg-slate-900/80">
                  <p class="mb-2 text-xs text-slate-500">Next</p>
                  <p class="font-semibold text-white transition group-hover:text-cyan-200">{next.data.title}</p>
                </a>
              ) : <div />}
            </div>
          </div>
        </section>
      )}
    </main>

    <Footer />
  </div>
</BaseLayout>
