---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { getCollection } from "astro:content";

const projects = await getCollection("projects");
const allTags = ["All", ...Array.from(
  new Set(
    projects.flatMap((p) =>
      p.data.tech.split(",").map((t: string) => t.trim())
    )
  )
)];
---

<BaseLayout
  title="Projects | Alessandro Campos"
  description="Developer portfolio projects built with SQL, PHP, HTML, CSS, JavaScript, React, Supabase and Astro."
>
  <div class="min-h-screen flex flex-col">
    <Header />

    <main class="flex-1">
      <section class="hero-shell border-b border-white/10">
        <div class="container-custom grid gap-10 py-20 md:py-24 lg:grid-cols-[1fr_0.55fr] lg:items-end">
          <div>
            <p class="mb-5 text-sm uppercase tracking-[0.28em] text-cyan-300">Projects / Workbench</p>
            <h1 class="max-w-4xl text-4xl font-bold leading-tight md:text-5xl">
              Practical systems, dashboards and database-driven web apps.
            </h1>
            <p class="mt-6 max-w-3xl text-lg leading-9 text-slate-300">
              A focused collection of projects where I practice backend logic, database workflows,
              responsive interfaces and deployment.
            </p>
            <p class="mt-3 max-w-3xl text-base leading-8 text-slate-400">
              Proyectos pensados para resolver necesidades reales: administrar informacion,
              visualizar datos y simplificar operaciones.
            </p>
          </div>

          <aside class="rounded-xl border border-white/10 bg-slate-950/70 p-6">
            <p class="text-sm font-semibold text-white">Project Index</p>
            <div class="mt-5 grid grid-cols-2 gap-4">
              <div class="stat-tile">
                <p class="text-3xl font-bold text-white">{projects.length}</p>
                <p class="mt-1 text-sm text-slate-400">Total projects</p>
              </div>
              <div class="stat-tile">
                <p class="text-3xl font-bold text-white">{allTags.length - 1}</p>
                <p class="mt-1 text-sm text-slate-400">Tech tags</p>
              </div>
            </div>
          </aside>
        </div>
      </section>

      <section class="container-custom py-12 md:py-16">
        <div class="mb-8 flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
          <div>
            <p class="mb-2 text-sm uppercase tracking-[0.28em] text-cyan-300">Filter stack</p>
            <h2 class="text-2xl font-bold">Browse by technology</h2>
          </div>
          <p id="project-counter" class="text-sm text-slate-400">
            Showing <span id="visible-count">{projects.length}</span> of {projects.length} projects
          </p>
        </div>

        <div class="mb-10 flex flex-wrap gap-2">
          {allTags.map((tag) => (
            <button
              class="filter-btn rounded-lg border px-4 py-2 text-sm font-medium transition"
              data-tag={tag}
              data-active={tag === "All" ? "true" : "false"}
            >
              {tag}
            </button>
          ))}
        </div>

        <div id="projects-grid" class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
          {projects.map((project, i) => (
            <div class="project-item" data-tech={project.data.tech}>
              <ProjectCard
                title={project.data.title}
                description={project.data.description}
                tech={project.data.tech}
                slug={project.data.slug}
                github={project.data.github}
                demo={project.data.demo}
                index={i + 1}
              />
            </div>
          ))}
        </div>

        <div id="empty-state" class="hidden py-20 text-center">
          <div class="mx-auto mb-6 flex h-16 w-16 items-center justify-center rounded-xl border border-white/10 bg-white/5">
            <span class="font-mono text-2xl text-slate-500">[]</span>
          </div>
          <h2 class="mb-2 text-xl font-semibold text-white">No projects found</h2>
          <p class="text-slate-400">No projects match that technology. Try a different filter.</p>
          <button id="reset-filter" class="mt-6 rounded-lg border border-white/10 px-5 py-2 text-sm text-slate-300 transition hover:border-cyan-300 hover:text-cyan-300">
            Show all projects
          </button>
        </div>
      </section>
    </main>

    <Footer />
  </div>
</BaseLayout>

<style>
  .filter-btn[data-active="true"] {
    background-color: rgba(103, 232, 249, 0.16);
    border-color: rgba(103, 232, 249, 0.5);
    color: #a5f3fc;
  }
  .filter-btn[data-active="false"] {
    background-color: rgba(255, 255, 255, 0.05);
    border-color: rgba(255, 255, 255, 0.1);
    color: #94a3b8;
  }
  .filter-btn[data-active="false"]:hover {
    border-color: rgba(103, 232, 249, 0.35);
    color: #e2e8f0;
  }
  .project-item {
    transition: opacity 0.2s ease, transform 0.2s ease;
  }
  .project-item.hidden {
    display: none;
  }
</style>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>(".filter-btn");
  const items = document.querySelectorAll<HTMLElement>(".project-item");
  const emptyState = document.getElementById("empty-state");
  const visibleCount = document.getElementById("visible-count");
  const resetBtn = document.getElementById("reset-filter");

  function setActiveFilter(tag: string) {
    buttons.forEach((btn) => {
      btn.dataset.active = btn.dataset.tag === tag ? "true" : "false";
    });

    let count = 0;
    items.forEach((item) => {
      const tech = item.dataset.tech ?? "";
      const techList = tech.split(",").map((t) => t.trim());
      const matches = tag === "All" || techList.includes(tag);
      item.classList.toggle("hidden", !matches);
      if (matches) count++;
    });

    if (visibleCount) visibleCount.textContent = String(count);
    if (emptyState) emptyState.classList.toggle("hidden", count > 0);
  }

  buttons.forEach((btn) => {
    btn.addEventListener("click", () => {
      setActiveFilter(btn.dataset.tag ?? "All");
    });
  });

  resetBtn?.addEventListener("click", () => {
    setActiveFilter("All");
  });
</script>
