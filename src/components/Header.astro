---
const english = Astro.url.pathname.startsWith("/en/");
const home = english ? "/en/" : "/";
---
<header class="sticky top-0 z-50 border-b border-white/10 bg-black/30 backdrop-blur-md">
  <div class="container-custom flex flex-wrap items-center justify-between gap-x-4 gap-y-1 py-4">
    <a href={home} class="text-xl font-bold tracking-wide text-cyan-400">
      Alessandro Campos
    </a>

    <nav class="flex flex-wrap gap-x-4 text-sm text-slate-300">
      <a href={home} class="hover:text-cyan-400 transition">{english?"Home":"Inicio"}</a>
      <a href={home+"about/"} class="hover:text-cyan-400 transition">{english?"About":"Sobre mí"}</a>
      <a href={home+"projects/"} class="hover:text-cyan-400 transition">{english?"Projects":"Proyectos"}</a>
      <a href={home+"contact/"} class="hover:text-cyan-400 transition">{english?"Contact":"Contacto"}</a>
      <a href={home+"resume/"} class="hover:text-cyan-400 transition">{english?"Résumé":"CV"}</a>
    </nav>
  </div>
</header>

