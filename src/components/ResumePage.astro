---
import JournalPage from "../layouts/JournalPage.astro";
interface Props { english?:boolean }
const {english=false}=Astro.props;
const t=(es:string,en:string)=>english?en:es;
---
<JournalPage {english} slug="resume" title={t("Currículum","Résumé")} description={t("Alessandro Campos · Desarrollo web y bases de datos · Costa Rica","Alessandro Campos · Web development and databases · Costa Rica")}>
  <section><h2>{t("Perfil profesional","Professional profile")}</h2><p>{t("Estudiante de Ingeniería de Sistemas en la UTC, con graduación prevista en noviembre de 2026. Desarrollo aplicaciones web con PHP, SQL y JavaScript. Español nativo e inglés B2.","Systems Engineering student at UTC, expecting to graduate in November 2026. I build web apps with PHP, SQL and JavaScript. Native Spanish speaker with B2 English.")}</p>
    <div class="actions"><a class="download" href="/resume.pdf" download>{t("Descargar CV","Download résumé")} (PDF)</a>
    <a href="/resume.pdf" target="_blank" rel="noopener noreferrer">{t("Abrir PDF","Open PDF")} &nearr;</a>
    <a href={english?"/en/contact/":"/contact/"}>{t("Contacto","Contact")}</a></div>
    <iframe src="/resume.pdf" title={t("Currículum de Alessandro Campos","Alessandro Campos résumé")}></iframe>
  </section>
</JournalPage>
<style>
section{padding:1.75rem 0}h2{font-size:1.5rem;font-weight:600}p{max-width:42rem;line-height:1.7;color:var(--muted);margin:.75rem 0}
.actions{display:flex;align-items:center;flex-wrap:wrap;gap:1.25rem;margin:1.3rem 0;color:var(--accent)}.download{background:var(--accent);color:var(--bg);padding:.7rem 1rem;border-radius:4px;font-weight:600}a:hover{text-decoration:underline}iframe{width:100%;height:80vh;border:1px solid var(--border)}@media(max-width:700px){iframe{display:none}}
</style>
